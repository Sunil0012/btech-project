\@writefile{lot}{\contentsline {table}{\numberline {V}{\ignorespaces The Cold-Start Wall. New or unpopular problems (Q4) are 22 percentage points harder to predict. This is not a model failure; it is an information shortage.}}{4}{table.5}\protected@file@percent }
\newlabel{tab:coldstart}{{V}{4}{The Cold-Start Wall. New or unpopular problems (Q4) are 22 percentage points harder to predict. This is not a model failure; it is an information shortage}{table.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {VI}{\ignorespaces Fairness Problem. The model predicts "Hard" far more often than "Easy." True Easy problems are recalled at 27\%, but Medium/Hard at 94\%. This bias reflects class imbalance and is a decision you must make explicitly.}}{4}{table.6}\protected@file@percent }
\newlabel{tab:fairness}{{VI}{4}{Fairness Problem. The model predicts "Hard" far more often than "Easy." True Easy problems are recalled at 27\%, but Medium/Hard at 94\%. This bias reflects class imbalance and is a decision you must make explicitly}{table.6}{}}
