\@writefile{lot}{\contentsline {table}{\numberline {VII}{\ignorespaces Noise Robustness. DARS tolerates small measurement errors. If your acceptance rate is accurate to within 10\%, you are safe. Beyond 15\% noise, performance suffers.}}{4}{table.7}\protected@file@percent }
\newlabel{tab:noise}{{VII}{4}{Noise Robustness. DARS tolerates small measurement errors. If your acceptance rate is accurate to within 10\%, you are safe. Beyond 15\% noise, performance suffers}{table.7}{}}
