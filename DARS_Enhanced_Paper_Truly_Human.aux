\@writefile{lot}{\contentsline {table}{\numberline {I}{\ignorespaces Head-to-head. DARS wins on everything. The 3.3\% gap over SAKT is not huge, but combined with better calibration, it matters.}}{2}{table.1}\protected@file@percent }
