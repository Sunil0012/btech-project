\@writefile{lot}{\contentsline {table}{\numberline {V}{\ignorespaces Cold-start is brutal. New/unpopular problems (Q4) are 22 points harder to predict. This is not a model failure; it's information scarcity.}}{3}{table.5}\protected@file@percent }
